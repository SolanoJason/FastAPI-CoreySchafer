ENVIRONMENT=development

# Database
DB__PASSWORD=
DB__NAME=

# Required when ENVIRONMENT=production. The private key may use literal
# `\n` sequences when supplied as a single environment variable.
GCS_PROJECT=
GCS_BUCKET=
GCS_SERVICE_ACCOUNT_EMAIL=
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
